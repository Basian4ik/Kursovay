<Page x:Class="Поликлиника.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:Поликлиника"
      mc:Ignorable="d"
      Title="AuthPage" Height="450" Width="800" >
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Логин"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="5" FontSize="14"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="LoginTB"
                 HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                 Margin="5" FontSize="14"/>

        <Button Name="LoginBtn" Grid.Row="1" Grid.Column="1" Content="Войти"
                HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="5" FontSize="14" Click="LoginBtn_Click"/>
    </Grid>
</Page>