<Page x:Class="Поликлиника.ClientHistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:Поликлиника"
      mc:Ignorable="d"
      d:DesignHeight="700" d:DesignWidth="900"
      Title="История болезней" >

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Шапка -->
            <RowDefinition Height="2*"/>
            <!-- Истории болезней -->
            <RowDefinition Height="3*"/>
            <!-- Нижняя часть (лечения и операции) -->
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="5,0,0,10">
            <TextBlock Name="PatientFIOTB" FontSize="18" FontWeight="Bold"/>
            <TextBlock Name="PatientInfoTB" FontSize="14" Foreground="#6B7280"/>
        </StackPanel>

        <!-- Блок 1: Истории болезней -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="5,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Истории болезней" FontSize="16"
                           FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Добавить болезнь" FontSize="14"
                        Padding="10,4" Click="AddHistory_Click"/>
            </Grid>

            <ListView Name="HistoryListView" Grid.Row="1" Margin="5,0,5,0"
                      SelectionChanged="HistoryListView_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Дата заболевания" Width="140"
                                        DisplayMemberBinding="{Binding Дата_заболевания}"/>
                        <GridViewColumn Header="Дата выздоровления" Width="150"
                                        DisplayMemberBinding="{Binding Дата_выздоровления}"/>
                        <GridViewColumn Header="Диагноз" Width="230"
                                        DisplayMemberBinding="{Binding Диагноз}"/>
                        <GridViewColumn Header="Вид лечения" Width="140"
                                        DisplayMemberBinding="{Binding Вид_лечения}"/>
                        <GridViewColumn Header="Врач" Width="180">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding Врачи.Фамилия}"/>
                                        <Run Text="{Binding Врачи.Имя}"/>
                                        <Run Text="{Binding Врачи.Отчество}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Блок 2: Листы лечения и Операции -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: Листы лечения -->
            <Grid Grid.Column="0" Margin="0,0,5,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="5,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Листы лечения" FontSize="16"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Name="AddTreatmentBtn" Content="Добавить"
                            FontSize="14" Padding="10,4" Click="AddTreatment_Click"
                            IsEnabled="False"/>
                </Grid>

                <ListView Name="TreatmentListView" Grid.Row="1" Margin="5,0,5,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Дата" Width="90"
                                            DisplayMemberBinding="{Binding Дата_лечения}"/>
                            <GridViewColumn Header="Темп." Width="70"
                                            DisplayMemberBinding="{Binding Температура}"/>
                            <GridViewColumn Header="Давл." Width="70"
                                            DisplayMemberBinding="{Binding Давление}"/>
                            <GridViewColumn Header="Лекарства" Width="140"
                                            DisplayMemberBinding="{Binding Лекарства}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>

            <!-- Правая колонка: Операции -->
            <Grid Grid.Column="1" Margin="5,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="5,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Операции" FontSize="16"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Name="AddOperationBtn" Content="Добавить"
                            FontSize="14" Padding="10,4" Click="AddOperation_Click"
                            IsEnabled="False"/>
                </Grid>

                <ListView Name="OperationListView" Grid.Row="1" Margin="5,0,5,0">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Дата" Width="100"
                                            DisplayMemberBinding="{Binding Дата_операции}"/>
                            <GridViewColumn Header="Описание" Width="160"
                                            DisplayMemberBinding="{Binding Описание_операции}"/>
                            <GridViewColumn Header="Результат" Width="140"
                                            DisplayMemberBinding="{Binding Результат_операции}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>